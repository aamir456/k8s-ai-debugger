{
  "title": "Notes App",
  "uid": "notes-app",
  "tags": ["k8s-ai-debugger"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "schemaVersion": 39,
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "prometheus"}}
  ]},
  "panels": [
    {"type": "stat", "title": "Ready pods", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "sum(kube_pod_status_ready{namespace=\"demo-app\",pod=~\"notes-app-.*\",condition=\"true\"})"}]},
    {"type": "stat", "title": "Restarts (1h)", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"demo-app\"}[1h]))"}]},
    {"type": "stat", "title": "Redis ready", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "kube_statefulset_status_replicas_ready{namespace=\"demo-app\",statefulset=\"redis\"}"}]},
    {"type": "stat", "title": "5xx ratio (5m)", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"expr": "sum(rate(http_requests_total{namespace=\"demo-app\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"demo-app\"}[5m]))"}]},
    {"type": "stat", "title": "HPA replicas", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"demo-app\"}"}]},
    {"type": "stat", "title": "Firing alerts", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "count(ALERTS{alertstate=\"firing\",app=~\"notes-app|redis\"}) or vector(0)"}]},
    {"type": "timeseries", "title": "Requests / s by status", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "sum by (status) (rate(http_requests_total{namespace=\"demo-app\",path!~\"/healthz|/readyz|/metrics\"}[1m]))", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "p95 latency", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo-app\",path!~\"/healthz|/readyz|/metrics\"}[5m])))", "legendFormat": "p95"}]},
    {"type": "timeseries", "title": "Memory by pod vs limit", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "targets": [
       {"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"demo-app\",container=\"notes-app\"})", "legendFormat": "{{pod}}"},
       {"expr": "max(kube_pod_container_resource_limits{namespace=\"demo-app\",container=\"notes-app\",resource=\"memory\"})", "legendFormat": "limit"}]},
    {"type": "timeseries", "title": "CPU by pod (cores)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"demo-app\",container=\"notes-app\"}[1m]))", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "Container restarts", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"demo-app\"})", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "Leaked memory (chaos)", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "decmbytes"}},
     "targets": [{"expr": "chaos_leaked_megabytes{namespace=\"demo-app\"}", "legendFormat": "{{pod}}"}]}
  ]
}
